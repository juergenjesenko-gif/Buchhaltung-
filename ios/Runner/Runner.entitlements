<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- iCloud-Sicherung (FA-7.16, Lastenheft L-7.17): iCloud Documents, kein
     CloudKit. Container-ID wird aus der Bundle-ID abgeleitet; ein Wechsel der
     Bundle-ID (O-33) braucht einen neu angelegten Container im Apple
     Developer Portal (docs/STORE_ANMELDUNG.md). Unsignierte CI-Builds
     (ohne Signatur) werten die Datei nicht aus. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
