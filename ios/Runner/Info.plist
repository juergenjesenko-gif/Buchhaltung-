<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>mailto</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>JeNi bucht</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>JeNi bucht</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- image_picker: ohne diese Texte beendet iOS die App beim ersten Zugriff,
	     und die App-Store-Prüfung lehnt den Build ab. Die Formulierung muss
	     erklären, wozu der Zugriff dient – "wird benötigt" reicht nicht. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID entsperrt die App-Sperre. Die Auswertung erfolgt durch das Gerät; die App erhält keine biometrischen Daten.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Damit du Beträge und Notizen diktieren kannst. Die Sprache wird nur auf deinem iPhone erkannt und nicht übertragen.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Damit aus deinem Diktat Text wird – ausschließlich auf deinem iPhone, ohne Übertragung an Apple oder andere.</string>
	<key>NSCameraUsageDescription</key>
	<string>Damit du Belege direkt abfotografieren kannst, statt sie abzutippen.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Damit du bereits aufgenommene Belegfotos aus deiner Fotobibliothek als Beleg hinzufügen kannst.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Damit du eine erstellte Rechnung in deiner Fotobibliothek ablegen kannst.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Teilen-Ziel (L-27.4): „Öffnen in Buchhaltung“ für Belegbilder, PDF, XML -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Beleg</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
				<string>public.xml</string>
				<string>public.image</string>
				<string>public.comma-separated-values-text</string>
				<string>public.tab-separated-values-text</string>
				<string>public.plain-text</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- iCloud-Sicherung (FA-7.16, L-7.20): Container in der Dateien-App
	     sichtbar. Container-ID aus der Bundle-ID abgeleitet (O-33), gleich wie
	     in Runner.entitlements. -->
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>JeNi bucht</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>One</string>
		</dict>
	</dict>
</dict>
</plist>
