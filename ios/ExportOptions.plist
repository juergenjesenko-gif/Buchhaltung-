<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- teamID muss vor dem ersten Build eingetragen werden. Zu finden im
	     Apple Developer Portal unter "Membership Details". -->
	<key>teamID</key>
	<string>DEIN_TEAM_ID</string>
	<key>method</key>
	<string>app-store-connect</string>
	<key>uploadSymbols</key>
	<true/>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Bitcode ist seit Xcode 14 abgeschafft; explizit aus, damit ältere
	     Toolchains nicht doch versuchen, es einzubetten. -->
	<key>uploadBitcode</key>
	<false/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
